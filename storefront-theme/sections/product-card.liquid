{% liquid
  assign requested_path = request.path | default: category.url | default: collection.url | default: ''
  assign active_handle = requested_path | split: '/' | last
  assign active_category = ''
  assign active_label = ''

  case active_handle
    when 'gaming-desktops'
      assign active_category = 'Dell Gaming PC'
      assign active_label = 'Dell gaming PCs'
    when 'gaming-laptops'
      assign active_category = 'Dell Gaming Laptop'
      assign active_label = 'Dell gaming laptops'
    when 'gaming-accessories'
      assign active_category = 'Dell Accessory'
      assign active_label = 'Dell accessories'
  endcase

  if active_category == blank and category.title != blank
    assign active_category = category.title
    assign active_label = category.title
  endif

  assign source_products = category.products | default: collection.products | default: products
  assign products_per_page = section.settings.products_per_page | default: 24
%}

<section class="dell-category" data-dell-category="{{ active_category | escape }}">
  <div class="dell-category__inner">
    <header class="dell-category__header">
      <div class="dell-category__heading-group">
        <p class="dell-category__eyebrow">Dell catalogue</p>
        <h1 class="dell-category__title">
          {{ active_label | default: section.settings.heading | default: 'Dell gaming catalogue' | escape }}
        </h1>
      </div>

      <nav class="dell-category__nav" aria-label="Dell product categories">
        <a href="/category/gaming-desktops"{% if active_handle == 'gaming-desktops' %} aria-current="page"{% endif %}>Dell gaming PCs</a>
        <a href="/category/gaming-laptops"{% if active_handle == 'gaming-laptops' %} aria-current="page"{% endif %}>Dell gaming laptops</a>
        <a href="/category/gaming-accessories"{% if active_handle == 'gaming-accessories' %} aria-current="page"{% endif %}>Dell accessories</a>
      </nav>
    </header>

    {% paginate source_products by products_per_page %}
      <div class="dell-category__grid" role="list">
        {% liquid
          assign visible_count = 0
        %}

        {% for product in source_products %}
          {% liquid
            assign product_vendor = product.vendor | default: product.brand | strip
            assign product_category = product.metafields.catalogue.category | default: product.category | default: product.type | strip
            assign product_status = product.metafields.catalogue.active_status | default: product.status | default: product.published_status | strip | downcase
            assign product_is_active = false

            if product_status == 'active'
              assign product_is_active = true
            endif
          %}

          {% if product_vendor == 'Dell' and product_category == active_category and product_is_active %}
            {% liquid
              assign visible_count = visible_count | plus: 1
              assign product_image = product.featured_media.preview_image | default: product.featured_image
              assign image_alt = product_image.alt | default: product.title
              assign product_url = product.url
              assign delivery_estimate = product.metafields.catalogue.delivery_estimate | default: product.delivery_estimate | default: 'Delivery estimate pending'
              assign stock_status = product.metafields.catalogue.stock_status | default: product.stock_status

              if product_url == blank
                assign product_url = '/products/' | append: product.handle
              endif

              if stock_status == blank
                if product.available
                  assign stock_status = 'In Stock'
                else
                  assign stock_status = 'Out of Stock'
                endif
              endif
            %}

            <article class="dell-product-card" role="listitem">
              <a class="dell-product-card__link" href="{{ product_url }}" aria-label="View details for {{ product.title | escape }}">
                <span class="dell-product-card__media">
                  {% if product_image %}
                    {{
                      product_image
                      | image_url: width: 720
                      | image_tag:
                        widths: '240, 360, 480, 720',
                        sizes: '(min-width: 1120px) 25vw, (min-width: 760px) 33vw, 100vw',
                        loading: 'lazy',
                        alt: image_alt
                    }}
                  {% else %}
                    <span class="dell-product-card__placeholder" aria-label="Dell product image placeholder">Dell</span>
                  {% endif %}
                </span>

                <span class="dell-product-card__content">
                  <span class="dell-product-card__category">{{ active_category | escape }}</span>
                  <span class="dell-product-card__name">{{ product.title | escape }}</span>
                  <span class="dell-product-card__meta">
                    <span class="dell-product-card__stock{% if stock_status == 'Out of Stock' %} dell-product-card__stock--out{% endif %}">
                      {{ stock_status | escape }}
                    </span>
                    <span class="dell-product-card__delivery">{{ delivery_estimate | escape }}</span>
                  </span>
                  <span class="dell-product-card__footer">
                    <span class="dell-product-card__price">{{ product.price | money_with_currency }}</span>
                    <span class="dell-product-card__details">View details</span>
                  </span>
                </span>
              </a>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      {% if visible_count == 0 %}
        <div class="dell-category__empty" role="status">
          <h2>No active Dell products found</h2>
          <p>This category is configured to show only active Dell products in {{ active_category | escape }}.</p>
        </div>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="dell-category__pagination" aria-label="Category pages">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}">Previous</a>
          {% endif %}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<style>
  .dell-category {
    background: #f6f8f7;
    color: #1d1f21;
    min-height: 100vh;
    overflow-x: clip;
    padding: 32px 16px 48px;
  }

  .dell-category__inner {
    margin: 0 auto;
    max-width: 1180px;
    width: 100%;
  }

  .dell-category__header {
    align-items: end;
    border-bottom: 1px solid #d6dde0;
    display: flex;
    gap: 20px;
    justify-content: space-between;
    margin-bottom: 24px;
    padding-bottom: 18px;
  }

  .dell-category__heading-group {
    min-width: 0;
  }

  .dell-category__eyebrow {
    color: #5f625e;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    margin: 0 0 8px;
    text-transform: uppercase;
  }

  .dell-category__title {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    margin: 0;
  }

  .dell-category__nav {
    display: flex;
    flex: 0 1 auto;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
    min-width: 0;
  }

  .dell-category__nav a,
  .dell-category__pagination a {
    align-items: center;
    border: 1px solid #b9c3c0;
    border-radius: 6px;
    color: #1d1f21;
    display: inline-flex;
    font: inherit;
    font-weight: 700;
    justify-content: center;
    min-height: 44px;
    padding: 0 14px;
    text-decoration: none;
    white-space: normal;
  }

  .dell-category__nav a[aria-current="page"] {
    background: #143d33;
    border-color: #143d33;
    color: #ffffff;
  }

  .dell-category__grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .dell-product-card {
    background: #ffffff;
    border: 1px solid #d6dde0;
    border-radius: 8px;
    min-width: 0;
    overflow: hidden;
  }

  .dell-product-card__link {
    color: inherit;
    display: grid;
    height: 100%;
    text-decoration: none;
  }

  .dell-product-card__link:focus-visible {
    outline: 3px solid #2b6659;
    outline-offset: 3px;
  }

  .dell-product-card__media {
    align-items: center;
    aspect-ratio: 4 / 3;
    background: #e3e9e7;
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  .dell-product-card__media img,
  .dell-product-card__placeholder {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .dell-product-card__placeholder {
    align-content: center;
    background: linear-gradient(135deg, #f1f4f3 0%, #d9e2df 100%);
    color: #52615d;
    font-size: 1.25rem;
    font-weight: 800;
    text-align: center;
  }

  .dell-product-card__content {
    display: grid;
    gap: 10px;
    padding: 14px;
  }

  .dell-product-card__category {
    color: #5f625e;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .dell-product-card__name {
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .dell-product-card__meta,
  .dell-product-card__footer {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    justify-content: space-between;
  }

  .dell-product-card__stock {
    background: #e6f3eb;
    border-radius: 999px;
    color: #24643a;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 5px 10px;
  }

  .dell-product-card__stock--out {
    background: #f8e9e5;
    color: #8b2416;
  }

  .dell-product-card__delivery {
    color: #4d514c;
    font-size: 0.9rem;
  }

  .dell-product-card__price {
    font-size: 1.12rem;
    font-weight: 900;
  }

  .dell-product-card__details {
    color: #0f5143;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .dell-category__empty {
    background: #ffffff;
    border: 1px solid #d6dde0;
    border-radius: 8px;
    margin: 0 auto;
    max-width: 620px;
    padding: 28px;
  }

  .dell-category__empty h2 {
    font-size: 1.35rem;
    margin: 0 0 10px;
  }

  .dell-category__empty p {
    color: #5f625e;
    margin: 0;
  }

  .dell-category__pagination {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-top: 28px;
  }

  @media (max-width: 989px) {
    .dell-category__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .dell-category {
      padding: 24px 12px 40px;
    }

    .dell-category__header {
      align-items: stretch;
      display: grid;
    }

    .dell-category__nav {
      justify-content: start;
    }

    .dell-category__nav a {
      flex: 1 1 160px;
    }

    .dell-category__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Dell product cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "Dell gaming catalogue"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
