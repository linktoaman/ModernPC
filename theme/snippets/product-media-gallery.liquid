{% liquid
  assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign media_count = product.media.size
%}

<div class="product-media-gallery" data-product-media-gallery>
  {% if media_count > 0 %}
    <div class="product-media-gallery__stage">
      {% for media in product.media %}
        {% liquid
          assign media_image = media.preview_image
          assign media_alt = media.alt | default: product.title
          assign media_loading = 'lazy'
          assign is_active = false

          if featured_media and media.id == featured_media.id
            assign is_active = true
          elsif featured_media == blank and forloop.first
            assign is_active = true
          endif

          if forloop.first
            assign media_loading = 'eager'
          endif
        %}

        <figure
          class="product-media-gallery__item {% if is_active %}product-media-gallery__item--active{% endif %}"
          data-product-media-item
          data-media-id="{{ media.id }}"
          {% unless is_active %}hidden{% endunless %}
        >
          {% if media.media_type == 'image' %}
            {{
              media_image
              | image_url: width: 1400
              | image_tag:
                widths: '480, 720, 960, 1200, 1400',
                sizes: '(min-width: 990px) 52vw, 100vw',
                loading: media_loading,
                alt: media_alt
            }}
          {% else %}
            {{
              media_image
              | image_url: width: 1400
              | image_tag:
                widths: '480, 720, 960, 1200, 1400',
                sizes: '(min-width: 990px) 52vw, 100vw',
                loading: 'lazy',
                alt: media_alt
            }}
          {% endif %}

          {% if media.alt != blank %}
            <figcaption class="visually-hidden">{{ media.alt | escape }}</figcaption>
          {% endif %}
        </figure>
      {% endfor %}
    </div>

    {% if media_count > 1 %}
      <div class="product-media-gallery__thumbs" role="list" aria-label="Product images">
        {% for media in product.media %}
          {% liquid
            assign media_image = media.preview_image
            assign thumb_alt = media.alt | default: product.title
          %}
          <button
            class="product-media-gallery__thumb {% if featured_media and media.id == featured_media.id %}product-media-gallery__thumb--active{% elsif featured_media == blank and forloop.first %}product-media-gallery__thumb--active{% endif %}"
            type="button"
            data-product-media-thumb
            data-media-id="{{ media.id }}"
            aria-label="Show {{ thumb_alt | escape }}"
            {% if featured_media and media.id == featured_media.id %}
              aria-current="true"
            {% elsif featured_media == blank and forloop.first %}
              aria-current="true"
            {% endif %}
          >
            {{
              media_image
              | image_url: width: 180
              | image_tag:
                widths: '90, 140, 180',
                sizes: '90px',
                loading: 'lazy',
                alt: ''
            }}
          </button>
        {% endfor %}
      </div>
    {% endif %}
  {% else %}
    <div class="product-media-gallery__placeholder" role="img" aria-label="{{ product.title | escape }}"></div>
  {% endif %}
</div>
