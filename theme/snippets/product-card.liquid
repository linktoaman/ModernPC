{% liquid
  assign product_image = product.featured_media.preview_image | default: product.featured_image
  assign image_alt = product_image.alt | default: product.title
  assign price = product.price
  assign compare_price = product.compare_at_price
  assign product_url = product.url | within: collection
%}

<article class="product-card" role="listitem">
  <a class="product-card__link" href="{{ product_url }}" aria-label="View {{ product.title | escape }}">
    <span class="product-card__media">
      {% if product_image %}
        {{
          product_image
          | image_url: width: 720
          | image_tag:
            widths: '240, 360, 480, 720',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
            loading: 'lazy',
            alt: image_alt
        }}
      {% else %}
        <span class="product-card__placeholder" aria-hidden="true"></span>
      {% endif %}
    </span>

    <span class="product-card__content">
      <span class="product-card__title">{{ product.title | escape }}</span>
      <span class="product-card__price">
        {% if compare_price > price %}
          <s>{{ compare_price | money }}</s>
        {% endif %}
        <span>{{ price | money }}</span>
      </span>
      <span class="product-card__availability {% unless product.available %}product-card__availability--sold-out{% endunless %}">
        {% if product.available %}
          In stock
        {% else %}
          Sold out
        {% endif %}
      </span>
    </span>
  </a>
</article>
