{{ 'theme.css' | asset_url | stylesheet_tag }}

<script src="{{ 'analytics/events.js' | asset_url }}" defer></script>
<script src="{{ 'cart.js' | asset_url }}" defer></script>

<section
  class="cart-page"
  data-cart-page
  data-section-id="{{ section.id }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-change-url="{{ routes.cart_change_url | default: '/cart/change' }}"
  data-cart-currency="{{ cart.currency.iso_code | default: shop.currency }}"
>
  <div class="cart-page__inner">
    <header class="cart-page__header">
      <h1 class="cart-page__title">Your cart</h1>
      {% if cart.item_count > 0 %}
        <p class="cart-page__count" data-cart-count>
          {{ cart.item_count }}
          {% if cart.item_count == 1 %}
            item
          {% else %}
            items
          {% endif %}
        </p>
      {% endif %}
    </header>

    {% if cart.item_count == 0 %}
      <div class="cart-empty" role="status">
        <h2 class="cart-empty__title">Your cart is empty</h2>
        <p class="cart-empty__message">Add products to your cart and they will appear here before checkout.</p>
        <a class="cart-empty__link" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
      </div>
    {% else %}
      <form class="cart-form" action="{{ routes.cart_url }}" method="post" novalidate data-cart-form>
        <div class="cart-form__status" role="status" aria-live="polite" data-cart-status></div>
        <div class="cart-form__error" role="alert" hidden data-cart-error></div>

        <div class="cart-items" role="list">
          <div class="cart-items__head" aria-hidden="true">
            <span class="cart-items__head-product">Product</span>
            <span>Quantity</span>
            <span class="cart-items__head-price">Item price</span>
            <span class="cart-items__head-total">Line total</span>
          </div>

          {% for line_item in cart.items %}
            {% liquid
              assign quantity_max = line_item.variant.quantity_rule.max
              assign is_unavailable = false

              if quantity_max == blank and line_item.variant.inventory_management and line_item.variant.inventory_policy == 'deny'
                assign quantity_max = line_item.variant.inventory_quantity
              endif

              unless line_item.variant.available
                assign is_unavailable = true
              endunless
            %}
            {% render 'cart-line-item', line_item: line_item %}
            <span
              hidden
              data-cart-line-stock
              data-line-key="{{ line_item.key }}"
              data-product-id="{{ line_item.product_id }}"
              data-variant-id="{{ line_item.variant_id }}"
              {% if is_unavailable %}
                data-cart-line-unavailable="true"
              {% endif %}
              {% if quantity_max != blank and quantity_max >= 0 %}
                data-cart-stock-limit="{{ quantity_max }}"
              {% endif %}
            ></span>
          {% endfor %}
        </div>

        <footer class="cart-summary" aria-label="Cart totals">
          <div class="cart-summary__row">
            <span>Subtotal</span>
            <strong data-cart-subtotal>{{ cart.items_subtotal_price | money }}</strong>
          </div>

          {% if cart.total_discounts > 0 %}
            <div class="cart-summary__row cart-summary__row--discount">
              <span>Discounts</span>
              <strong data-cart-discounts>-{{ cart.total_discounts | money }}</strong>
            </div>
          {% endif %}

          <div class="cart-summary__row cart-summary__row--total">
            <span>Cart total</span>
            <strong data-cart-total>{{ cart.total_price | money }}</strong>
          </div>

          <p class="cart-summary__note">Taxes and delivery are calculated at checkout.</p>

          <div class="cart-summary__actions">
            <button class="cart-summary__update" type="submit" name="update">Update cart</button>
            <button class="cart-summary__checkout" type="submit" name="checkout" data-cart-checkout>Checkout</button>
          </div>
        </footer>
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
